# Gemini API key untuk AI Proxy (server-only). JANGAN commit nilai asli.
# Ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai proxy
GEMINI_MODEL=gemini-1.5-flash

# Konfigurasi rate-limit & cache proxy (opsional)
AI_RATE_LIMIT_PER_MINUTE=15
AI_CACHE_TTL_SECONDS=300
